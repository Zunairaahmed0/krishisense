# Copy this file to .env and fill in your values

# ── Backend (production) ──────────────────────────────────────────────────────
# Your deployed backend URL on Render — Claude.js will route AI calls through it
# Leave empty to use direct Gemini API (local dev only)
VITE_BACKEND_URL=https://krishisense-api.onrender.com

# ── Gemini (local dev fallback only) ──────────────────────────────────────────
# Only needed locally when VITE_BACKEND_URL is not set
# In production, keep this empty so the key stays off the browser
VITE_GEMINI_KEY=

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
